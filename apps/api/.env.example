# Manasiness API
#
# Copy this file to:
#
#   apps/api/.env
#
# Never commit real credentials or secrets.

# Required.
# Identifies the deployment/runtime context.
APP_ENV=development

# Optional.
# Stable service identity used by logging/observability.
API_SERVICE_NAME=manasiness-api

# Optional.
# Allowed values: debug, info, warn, error.
API_LOG_LEVEL=info

# Optional.
API_HOST=127.0.0.1
API_PORT=3001

# Maximum JSON and URL-encoded request body size in bytes.
API_BODY_LIMIT_BYTES=1048576

# Comma-separated HTTP(S) browser origins allowed by CORS.
API_CORS_ORIGINS=http://localhost:3000

# Required once the API consumes database infrastructure.
#
# The credential below is exclusively for the reproducible local
# PostgreSQL container and is not a production secret.
DATABASE_URL=postgresql://manasiness:manasiness_local@127.0.0.1:5432/manasiness_dev

# Optional database pool tuning.
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000