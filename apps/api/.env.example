# Manasiness API
#
# Copy this file to:
#
#   apps/api/.env
#
# Never commit real credentials or secrets.

APP_ENV=development

API_SERVICE_NAME=manasiness-api

# Structured log threshold.
#
# Allowed:
# debug
# info
# warn
# error
API_LOG_LEVEL=info

# Development-only human-readable logging.
#
# Production/test runtimes must use structured JSON.
API_LOG_PRETTY=true

API_HOST=127.0.0.1
API_PORT=3001

API_BODY_LIMIT_BYTES=1048576

API_CORS_ORIGINS=http://localhost:3000

API_DOCS_ENABLED=true

# Maximum readiness dependency-check duration.
API_READINESS_TIMEOUT_MS=2000

# Application runtime database.
#
# Uses the non-privileged runtime role.
DATABASE_URL=postgresql://manasiness_app:manasiness_app_local@127.0.0.1:5432/manasiness_dev

DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000