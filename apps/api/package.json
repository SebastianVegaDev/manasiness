{
    "name": "@manasiness/api",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "predev": "pnpm --filter @manasiness/contracts build && pnpm --filter @manasiness/database build",
        "dev": "nest start --watch",
        "build": "nest build",
        "prestart": "pnpm --filter @manasiness/contracts build && pnpm --filter @manasiness/database build",
        "start": "node dist/main.js",
        "lint": "eslint . --no-error-on-unmatched-pattern",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "pnpm -w test:api"
    },
    "dependencies": {
        "@manasiness/contracts": "workspace:*",
        "@manasiness/database": "workspace:*",
        "@nestjs/common": "12.1.0",
        "@nestjs/core": "12.1.0",
        "@nestjs/platform-express": "12.1.0",
        "@nestjs/swagger": "12.0.2",
        "helmet": "8.3.0",
        "nestjs-pino": "5.2.1",
        "pino": "10.3.1",
        "pino-http": "11.0.0",
        "reflect-metadata": "0.2.2",
        "rxjs": "7.8.2",
        "zod": "4.6.5"
    },
    "devDependencies": {
        "@manasiness/eslint-config": "workspace:*",
        "@manasiness/typescript-config": "workspace:*",
        "@nestjs/cli": "12.0.7",
        "@types/node": "24.13.6",
        "eslint": "10.11.0",
        "pino-pretty": "13.1.3",
        "typescript": "6.0.3"
    }
}