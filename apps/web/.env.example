# Manasiness Web
#
# Copy this file to:
#
#   apps/web/.env
#
# Never commit real credentials or secrets.

# Required.
APP_ENV=development

# Required, server-only.
#
# Used by server-side Next.js code when communicating with
# the NestJS API. In production this may eventually point to
# an internal/private service address.
WEB_API_ORIGIN=http://127.0.0.1:3001

# Required, browser-safe and build-time.
#
# This value is deliberately exposed to browser JavaScript.
# It must never contain credentials or secrets.
NEXT_PUBLIC_API_ORIGIN=http://127.0.0.1:3001