{
    "name": "manasiness",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.6.0",
    "engines": {
        "node": ">=24.21.0 <25",
        "pnpm": "12.6.0"
    },
    "scripts": {
        "dev": "turbo run dev",
        "build": "turbo run build",
        "lint": "pnpm lint:root && turbo run lint",
        "lint:root": "eslint \"*.{js,mjs,cjs}\"",
        "typecheck": "pnpm typecheck:tools && turbo run typecheck",
        "typecheck:tools": "tsc -p tsconfig.tools.json --noEmit",
        "test": "pnpm test:unit && pnpm test:integration",
        "test:unit": "vitest run --project unit",
        "test:web": "vitest run --project unit apps/web/test/unit",
        "test:integration:prepare": "pnpm db:up && pnpm db:reset:test",
        "test:database": "pnpm test:integration:prepare && vitest run --project integration",
        "test:api": "pnpm test:integration:prepare && vitest run --project api",
        "test:integration": "pnpm test:integration:prepare && vitest run --project integration --project api",
        "test:e2e:prepare": "pnpm --filter @manasiness/contracts build && pnpm db:up && pnpm db:reset:test",
        "test:e2e": "pnpm test:e2e:prepare && playwright test",
        "test:e2e:install": "playwright install chromium",
        "test:all": "pnpm test && pnpm test:e2e",
        "test:watch": "vitest",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "db:up": "docker compose up -d --wait postgres",
        "db:stop": "docker compose stop postgres",
        "db:logs": "docker compose logs -f postgres",
        "db:generate": "pnpm --filter @manasiness/database db:generate",
        "db:check": "pnpm --filter @manasiness/database db:check",
        "db:migrate": "pnpm --filter @manasiness/database db:migrate",
        "db:reset:dev": "pnpm --filter @manasiness/database db:reset:dev",
        "db:reset:test": "pnpm --filter @manasiness/database db:reset:test",
        "db:validate": "pnpm --filter @manasiness/database db:validate"
    },
    "devDependencies": {
        "@manasiness/eslint-config": "workspace:*",
        "@playwright/test": "1.63.0",
        "@types/node": "24.13.6",
        "eslint": "10.11.0",
        "prettier": "3.9.9",
        "turbo": "2.11.2",
        "typescript": "6.0.3",
        "vitest": "5.0.2"
    }
}
