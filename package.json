{
    "name": "manasiness",
    "version": "0.0.0",
    "private": true,
    "packageManager": "pnpm@12.6.0",
    "engines": {
        "node": ">=24.21.0 <25",
        "pnpm": "12.6.0"
    },
    "scripts": {
        "dev": "turbo run dev",
        "build": "turbo run build",
        "lint": "pnpm lint:root && turbo run lint",
        "lint:root": "eslint \"*.{js,mjs,cjs}\"",
        "typecheck": "turbo run typecheck",
        "test": "turbo run test",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "db:up": "docker compose up -d --wait postgres",
        "db:stop": "docker compose stop postgres",
        "db:logs": "docker compose logs -f postgres",
        "db:generate": "pnpm --filter @manasiness/database db:generate",
        "db:check": "pnpm --filter @manasiness/database db:check",
        "db:migrate": "pnpm --filter @manasiness/database db:migrate",
        "db:reset:dev": "pnpm --filter @manasiness/database db:reset:dev",
        "db:reset:test": "pnpm --filter @manasiness/database db:reset:test",
        "db:validate": "pnpm --filter @manasiness/database db:validate"
    },
    "devDependencies": {
        "@manasiness/eslint-config": "workspace:*",
        "eslint": "10.11.0",
        "prettier": "3.9.9",
        "turbo": "2.11.2",
        "typescript": "6.0.3"
    }
}