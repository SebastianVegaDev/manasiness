{
    "name": "@manasiness/contracts",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "main": "./dist/index.js",
    "types": "./src/index.ts",
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "import": "./dist/index.js"
        }
    },
    "scripts": {
        "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
        "build": "tsc -p tsconfig.build.json",
        "lint": "eslint . --no-error-on-unmatched-pattern",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "tsx --test \"test/**/*.test.ts\""
    },
    "dependencies": {
        "zod": "4.6.5"
    },
    "devDependencies": {
        "@manasiness/eslint-config": "workspace:*",
        "@manasiness/typescript-config": "workspace:*",
        "@types/node": "24.13.6",
        "eslint": "10.11.0",
        "tsx": "4.23.15",
        "typescript": "6.0.3"
    }
}