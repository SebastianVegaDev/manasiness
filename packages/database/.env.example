# Manasiness database tooling
#
# Copy this file to:
#
#   packages/database/.env
#
# These credentials are only for the local Docker database.

DATABASE_URL=postgresql://manasiness:manasiness_local@127.0.0.1:5432/manasiness_dev

DATABASE_TEST_URL=postgresql://manasiness:manasiness_local@127.0.0.1:5432/manasiness_test

DATABASE_MIGRATION_VALIDATION_URL=postgresql://manasiness:manasiness_local@127.0.0.1:5432/manasiness_migration_validation

DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000