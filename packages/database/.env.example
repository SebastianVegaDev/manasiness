# Manasiness database tooling
#
# Copy this file to:
#
#   packages/database/.env
#
# These credentials are exclusively for the reproducible local
# PostgreSQL environment.

# Migration/tooling connection.
#
# This role owns local schema evolution and must not be reused by
# the API runtime.
DATABASE_URL=postgresql://manasiness:manasiness_local@127.0.0.1:5432/manasiness_dev

# Administrative test connection used to create/reset test fixtures.
DATABASE_TEST_URL=postgresql://manasiness:manasiness_local@127.0.0.1:5432/manasiness_test

# Runtime-role test connection used to exercise real RLS behavior.
DATABASE_TEST_RUNTIME_URL=postgresql://manasiness_app:manasiness_app_local@127.0.0.1:5432/manasiness_test

# Clean migration-history validation target.
DATABASE_MIGRATION_VALIDATION_URL=postgresql://manasiness:manasiness_local@127.0.0.1:5432/manasiness_migration_validation

DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000