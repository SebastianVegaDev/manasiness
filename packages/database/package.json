{
    "name": "@manasiness/database",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "main": "./dist/index.js",
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "import": "./dist/index.js"
        },
        "./schema": {
            "types": "./src/schema/index.ts",
            "import": "./dist/schema/index.js"
        },
        "./testing": {
            "types": "./src/testing/index.ts",
            "import": "./dist/testing/index.js"
        }
    },
    "scripts": {
        "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
        "build": "tsc -p tsconfig.build.json",
        "lint": "eslint . --no-error-on-unmatched-pattern",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "node --test",
        "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
        "db:check": "drizzle-kit check --config=drizzle.config.ts",
        "db:migrate": "tsx scripts/migrate.ts",
        "db:reset:dev": "tsx scripts/reset-development.ts",
        "db:reset:test": "tsx scripts/reset-test.ts",
        "db:validate:migrations": "tsx scripts/validate-migrations.ts",
        "db:validate": "pnpm db:check && pnpm db:validate:migrations"
    },
    "dependencies": {
        "@manasiness/platform-primitives": "workspace:*",
        "drizzle-orm": "0.45.3",
        "pg": "8.23.0",
        "zod": "4.6.5"
    },
    "devDependencies": {
        "@manasiness/eslint-config": "workspace:*",
        "@manasiness/typescript-config": "workspace:*",
        "@types/node": "24.13.6",
        "@types/pg": "8.23.1",
        "drizzle-kit": "0.31.11",
        "eslint": "10.11.0",
        "tsx": "4.23.15",
        "typescript": "6.0.3"
    }
}