{
    "$schema": "./node_modules/turbo/schema.json",
    "tasks": {
        "build": {
            "dependsOn": [
                "^build"
            ],
            "inputs": [
                "$TURBO_DEFAULT$",
                ".env",
                ".env.*"
            ],
            "outputs": [
                "dist/**",
                "build/**",
                ".next/**",
                "!.next/cache/**",
                "!.next/dev/**"
            ]
        },
        "dev": {
            "cache": false,
            "persistent": true,
            "passThroughEnv": [
                "APP_ENV",
                "API_*",
                "WEB_*",
                "NEXT_PUBLIC_*"
            ]
        },
        "lint": {
            "dependsOn": [
                "^lint"
            ]
        },
        "typecheck": {
            "dependsOn": [
                "^typecheck"
            ],
            "inputs": [
                "$TURBO_DEFAULT$",
                ".env",
                ".env.*"
            ]
        },
        "test": {
            "dependsOn": [
                "^test"
            ]
        }
    }
}
